# AWDAX backend settings. Copy to .env (git-ignored) and fill in the values marked REQUIRED.
# A line starting with # shows a setting at its default value: remove the # only to change it.
# docs/CONFIGURATION.md explains each one; docs/DEPLOY.md lists what a server needs.

# --- Required ------------------------------------------------------------------------------------------------------
# Gemini: the model that plans requests, ranks websites and reads pages.
GEMINI_API_KEY=
# Your Supabase project URL. The backend checks every sign-in token against its published keys.
SUPABASE_URL=
# Mixed into the hash of every API key. Set once and keep it: changing it invalidates every existing key.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=

# --- Server --------------------------------------------------------------------------------------------------------
PORT=8000
# Where the database file lives (chats, scraped rows, API keys, usage). Default: regulatory.sqlite beside the code.
# SQLITE_PATH=
# Local development only (npm run dev:agent, no sign-in): trusts unverified X-User-Id / tokens. Never in production.
# AWDAX_AUTH_MODE=dev
# Only if your own authenticating proxy sends X-User-Id + X-Proxy-Secret; normally empty.
# PROXY_SHARED_SECRET=
# For tokens signed with a shared secret instead of Supabase's published keys.
# SUPABASE_JWT_SECRET=
# FLASK_DEBUG=1 turns on the Werkzeug debugger for `python app.py` (local only).
# GUNICORN_THREADS=64

# --- Concurrent runs -----------------------------------------------------------------------------------------------
# Runs active at once in total and per signed-in user. A run past either limit waits in line ("Waiting for a free slot") and starts
# by itself when one frees up; only a full line is refused with a 429. Pausing or deleting a chat stops its run and frees the slot.
# Each run may open several Chrome windows (see DISCOVERY_INSPECT_WORKERS and SCRAPE_WORKERS): size these to the machine's memory.
# AWDAX_MAX_RUNS=10
# AWDAX_MAX_RUNS_PER_USER=5
# AWDAX_MAX_QUEUE=20

# --- Models --------------------------------------------------------------------------------------------------------
# GEMINI_MODEL=gemini-3.5-flash          (a retired model falls back to gemini-flash-latest; Gemini 3 keeps its default temperature)
# GEMINI_SEARCH_MODEL=gemini-3.5-flash   (the model that searches Google)
# GEMINI_ATTEMPTS=3                      (busy or timed-out answers are asked again after a short growing pause)
# NVIDIA models are tried before Gemini when a key is set:
# NVIDIA_API_KEY=
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# LLM_MODEL=
# NVIDIA_MODELS=
# NVIDIA_TIMEOUT_SECONDS=90
# NVIDIA_COOLDOWN_SECONDS=300

# --- Finding sources -----------------------------------------------------------------------------------------------
# Before discovery Gemini searches Google and ranks the best websites; they are tried first, best first.
# RESEARCH_FIRST=1
# RESEARCH_TOP_SITES=5
# Sources to look for, tried at once, and attempts before giving up:
# DISCOVERY_MAX_SOURCES=6
# DISCOVERY_INSPECT_WORKERS=3
# DISCOVERY_MAX_INSPECT_ATTEMPTS=60
# The searches that follow stop once this many sources are accepted, or after this many seconds once one is.
# DISCOVERY_ENOUGH_SOURCES=4
# DISCOVERY_MAX_SECONDS=300
# DISCOVERY_GEMINI_ROUNDS=5
# SEARCH_QUERY_COUNT=10
# Extra search backends (optional): SOURCE_SEARCH_BACKEND=auto|api|gemini|selenium
# SOURCE_SEARCH_BACKEND=auto
# SOURCE_SEARCH_GEMINI=1
# TAVILY_API_KEY=
# SERPER_API_KEY=
# USE_SELENIUM_GOOGLE=0
# GOOGLE_SEARCH_HEADLESS=1

# --- Reading pages -------------------------------------------------------------------------------------------------
# Rows each source gives, and pages followed:
# SCRAPE_MAX_PAGES=3
# SCRAPE_WORKERS=3
# Seconds between live re-scrapes of a chat (minimum 15).
# LIVE_SCRAPE_INTERVAL_SEC=3600
# A page built by JavaScript is read through the browser's accessibility tree, pager included (0 = read the plain HTML instead).
# AX_READER=1
# AX_MAX_PAGES=10
# AX_MAX_CHARS=120000
# AX_CHUNK_CHARS=60000
# AX_MAX_PARTS=6
# A table filled by JavaScript is read from the JSON feed behind it, page after page (0 turns this off).
# DATA_FEEDS=1
# FEED_MAX_ROWS=1000
# FEED_PAGE_SIZE=100
# FEED_MAX_PAGES=50
# Data files a source offers (CSV/TSV/XLSX/JSON) are downloaded to a temp file, read, and deleted once stored.
# DATASET_MAX_MB=50
# DATASET_MAX_ROWS=5000
# What the model is shown of an ordinary page, and how a long table is cut:
# GEMINI_SCRAPE_MAX_TEXT=70000
# GEMINI_SCRAPE_CONTEXT_CHARS=180000
# GEMINI_SCRAPE_NEXT_DATA_CHARS=200000
# GEMINI_SCRAPE_CHUNK_ROWS=60
# GEMINI_SCRAPE_MAX_CHUNKS=8
# GEMINI_SCRAPE_TEMPERATURE=0.15
# Browser:
# CHROME_BIN=
# CHROMEDRIVER_PATH=
# SELENIUM_PAGE_LOAD_SECONDS=45
# PAGE_SETTLE_SECONDS=12
# SCRAPE_FAST=1
# LISTING_MAX_SCROLLS=18
# LISTING_SCROLL_PAUSE=1.0
# INSPECT_ACCEPT_ZERO_ROWS=0
# EV_CATALOG_TARGET_MIN=50
# eGazette scrape depth:
# REGULATORY_SCRAPE_MAX_PAGES=3

# --- Google Maps (local businesses, "leads", "near me") ------------------------------------------------------------
# Create a key in Google Cloud, enable "Places API (New)" (required) and "Geocoding API" (optional: without it a named place is
# searched by name instead of tiled), and restrict the key to those two APIs. Without a key such requests use web discovery.
GOOGLE_MAPS_API_KEY=
# Free tier: 1,000 contact-detail searches a month. The caps below keep a run at $0; raise them only on purpose.
# PLACES_MONTHLY_CALL_CAP=1000
# PLACES_MAX_CALLS_PER_USER_DAY=200
# PLACES_MAX_CALLS_PER_RUN=40
# PLACES_MAX_RESULTS=300
# PLACES_TILE_KM=8
# PLACES_MAX_TILES_PER_LOCATION=16
# PLACES_WORKERS=4
# Fallback centre for "near me" when the browser gave no position, e.g. 28.61,77.21
# PLACES_DEFAULT_CENTER=
# Delete Maps data older than this many days at start-up (0 = keep).
# PLACES_RETENTION_DAYS=0
# After a Maps search, each business's own website is read for email, social links and site problems (0 turns it off):
# PLACES_SCRAPE_SITES=1
# PLACES_SITE_MAX=150
# PLACES_SITE_WORKERS=8
# PLACES_SITE_TIME_BUDGET_S=150
# PLACES_SITE_TIMEOUT_S=10

# --- MCP (Claude) ---------------------------------------------------------------------------------------------------
# `python -m mcp_server` listens here; /api/mcp on the API passes requests to it. See docs/MCP.md.
# MCP_PORT=8001
# MCP_UPSTREAM=
# AWDAX_INTERNAL_API=http://127.0.0.1:8000

# --- Website build (only for the Docker site image; public values, not secrets) --------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# The site's address for the HTTPS certificate, e.g. awdax.synapical.com (default: localhost).
# AWDAX_DOMAIN=
