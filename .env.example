DATABASE_URL=sqlite:///./awdax.db
# REDIS_URL=redis://localhost:6379/0
# OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
MIN_VALIDATED_SOURCES=3
MAX_SOURCES_TO_INSPECT=10
MAX_DISCOVERY_SEARCH_ROUNDS=8
MAX_DISCOVERY_ATTEMPTS=12
MAX_TOTAL_URLS_INSPECTED=36
BROWSER_TIMEOUT_MS=25000
BROWSER_MAX_RELATED_LINKS=4
AWDAX_HOST=0.0.0.0
AWDAX_PORT=8000
# Seconds between live refresh cycles (default 300 = 5 min)
LIVE_REFRESH_INTERVAL_SECONDS=300
LIVE_ERROR_RETRY_SECONDS=60
